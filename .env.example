# Copy to .env and fill in. .env is ignored; every key here has a placeholder and one comment line.

# MLflow: a local database by default. Ask the supervisor whether the lab has a shared server;
# then put https://<server> here and fill in the S3 keys below.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=nir-decomp-judge

# Shared tracking server only: the S3-compatible artifact store (for example MinIO).
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# One seed for random, NumPy and the framework; logged as a run parameter.
SEED=42

# Where the raw data lives on this machine (ignored by Git).
DATA_DIR=data

# DevAI smoke runner reads process environment only, not this file.
LITELLM_API_KEY=
# Optional overrides; omit unset values from the process environment.
DEVAI_API_BASE=
DEVAI_MODEL=
DEVAI_CUSTOM_LLM_PROVIDER=
DEVAI_MAX_TOKENS=16384
DEVAI_TIMEOUT_SECONDS=180
DEVAI_PR=not-opened

# OpenCode session limits; read from the process environment.
AGENT_TIMEOUT_SECONDS=600
AGENT_EXPECTED_VERSION=1.19.4

# Requirements judge; these settings are read from the process environment.
JUDGE_MAX_STEPS=16
JUDGE_TIMEOUT_SECONDS=600
JUDGE_EXPECTED_VERSION=1.19.4
JUDGE_DATASET=application
JUDGE_TASK=unspecified
JUDGE_PR=not-opened

# One-request judge; these settings are read from the process environment.
HOLISTIC_MAX_TOKENS=16384
HOLISTIC_TIMEOUT_SECONDS=600
HOLISTIC_MAX_PROMPT_BYTES=1000000
HOLISTIC_DATASET=application
HOLISTIC_TASK=unspecified
HOLISTIC_PR=not-opened
